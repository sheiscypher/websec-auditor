# Aucune valeur ici n'est un secret réel — ce fichier sert de modèle.
# PORT est fourni automatiquement par Render ; ne pas le définir en local
# si vous utilisez `uvicorn api.main:app --reload` (défaut : 8000).

LOG_LEVEL=INFO

# Origines autorisées en CORS, séparées par des virgules. "*" convient pour
# un outil de portfolio public en lecture seule (pas de session utilisateur).
ALLOWED_ORIGINS=*
